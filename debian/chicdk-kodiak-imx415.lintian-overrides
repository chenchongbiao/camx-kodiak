# The validated prebuilt IMX415 plugin searches the bundled CamX runtime directory.
chicdk-kodiak-imx415: custom-library-search-path
# Keep the validated vendor binary byte-identical to the maintained source file.
chicdk-kodiak-imx415: unstripped-binary-or-object
# These prebuilt plugins use their declared C++/libm/CamX dependencies
# without direct libc calls. Preserve the validated vendor ELF files.
chicdk-kodiak-imx415: library-not-linked-against-libc
